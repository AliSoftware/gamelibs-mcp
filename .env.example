# --- Steam -----------------------------------------------------------------
# Get a Web API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Provide EITHER your 64-bit SteamID...
STEAM_ID=
# ...or your vanity URL slug (steamcommunity.com/id/<slug>), resolved automatically.
STEAM_VANITY=

# Optional: override Steam install location / add extra library folders (e.g. mounted shares).
# STEAM_PATH=
# STEAM_EXTRA_LIBRARY_PATHS=D:\SteamLibrary;E:\Games\Steam   (';' or OS path-separator)

# --- IGDB (via Twitch) -----------------------------------------------------
# Register an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Epic (optional overrides) --------------------------------------------
# Epic needs no static secret. If you use Legendary/Heroic, auth is bootstrapped from
# their local user.json automatically. Override their config locations if non-standard:
# LEGENDARY_CONFIG_PATH=
# HEROIC_CONFIG_PATH=
# Install detection reads the OFFICIAL Epic Games Launcher's *.item manifests
# (Windows: %PROGRAMDATA%\Epic\EpicGamesLauncher\Data\Manifests) AND Legendary/Heroic's
# installed.json. Override the official manifests dir only if it's in a non-standard place:
# EPIC_MANIFESTS_PATH=
